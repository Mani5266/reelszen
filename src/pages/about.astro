    <img src="https://images.unsplash.com/photo-1601506521937-0121a7fc2a6b?q=70&w=600&auto=format&fit=crop" alt="Team at work" loading="lazy" decoding="async" class="rounded-2xl aspect-[4/5] object-cover w-full mt-8" width="600" height="750" />
  </div>
</div></section>
