---
import Base from '../layouts/Base.astro';
import { PRICING, inr } from '../data/pricing';
---
<Base title="Packages & Pricing — ReelsZen Hyderabad | No DM-for-price" description="Honest reel prices: Rs. 1,499 Quick Reel to Rs. 9,999 Wedding. One price on site + checkout, GST upfront.">
<section class="bg-ivory text-char pt-[120px] pb-24 min-h-screen"><div class="max-w-6xl mx-auto px-5">
  <span class="text-xs font-extrabold tracking-[3px] uppercase text-[#9a7a2e]">— Packages &amp; pricing</span>
  <h1 class="font-serif-d mt-3" style="font-size:clamp(34px,5vw,56px)">One honest ladder.</h1>
  <p class="text-char/70 max-w-[60ch] mt-2">Website, Instagram and checkout read from one table. GST shown upfront.</p>
  <div class="flex gap-2.5 flex-wrap my-7" id="tabs">
    {['all','weddings','events'].map((t,i) => <button data-tab={t} class:list={['px-5 py-2.5 rounded-full border-[1.5px] font-extrabold text-[13.5px] min-h-[44px] capitalize', i===0 ? 'bg-char text-ivory border-char' : 'bg-white border-char/15']}>{t}</button>)}
  </div>
  <div class="grid gap-4 md:grid-cols-3" id="pkgGrid">
    {PRICING.map(p => (
      <div data-cat={p.cat} class:list={['bg-white rounded-3xl p-7 border-[1.5px] flex flex-col pkg', p.hot ? 'border-gold text-ivory' : 'border-char/10']} style={p.hot ? 'background:linear-gradient(180deg,#171208,#241b0d)' : ''}>
        <h3 class="font-serif-d text-[22px]">{p.name}</h3><p class="text-[13.5px] opacity-75">{p.blurb}</p>
        <div class="text-4xl font-extrabold tracking-tight mt-2">{p.custom ? 'Custom' : inr(p.price)} {!p.custom && <small class="text-sm font-semibold text-taupe">+ GST</small>}</div>
        {!p.custom && <div class="text-[13px] rounded-xl px-3.5 py-2.5 mt-3 bg-sagesoft">Reserve today: <b>{inr(p.adv)}</b> · Balance {inr(p.price - p.adv)} before shoot</div>}
        <p class="text-[11px] font-extrabold tracking-[2px] uppercase text-taupe mt-4 mb-1">What's included:</p>
        <ul class="mb-4 flex-1">{p.feats.map(f => <li class="text-sm py-2 border-b border-dashed border-char/10">{f}</li>)}</ul>
        {p.custom ? <a class="btn-cta justify-center w-full" href="/contact">Get a quote →</a> : <a class="btn-cta justify-center w-full" href={`/book?package=${p.id}`}>Book Your Date →</a>}
      </div>
    ))}
  </div>
  <div class="mt-6 bg-white border border-dashed border-char/25 rounded-2xl p-5 text-sm text-char/70"><b>Add-ons:</b> Extra reel — Rs. 1,299 · Extra hour — Rs. 1,299 · Raw footage — <b>included free</b> on weddings. Balance due before shoot.</div>
</div></section>
<script>
  const tabs = document.getElementById('tabs');
  tabs?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-tab]') as HTMLElement | null; if (!b) return;
    const tab = b.dataset.tab!;
    tabs.querySelectorAll('[data-tab]').forEach(x => { const on = (x as HTMLElement).dataset.tab === tab; x.className = `px-5 py-2.5 rounded-full border-[1.5px] font-extrabold text-[13.5px] min-h-[44px] capitalize ${on ? 'bg-char text-ivory border-char' : 'bg-white border-char/15'}`; });
    document.querySelectorAll('.pkg').forEach(c => { const show = tab === 'all' || (c as HTMLElement).dataset.cat === tab; (c as HTMLElement).style.display = show ? '' : 'none'; });
  });
</script>
</Base>
